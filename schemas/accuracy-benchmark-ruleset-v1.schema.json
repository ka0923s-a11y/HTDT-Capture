{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htdt.example/schemas/accuracy-benchmark-ruleset-v1.schema.json",
  "title": "HTDT-Capture Accuracy Benchmark Ruleset v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "ruleset_version", "threshold_notice",
    "minimum_repeat_scans", "thresholds", "depth_buckets"
  ],
  "properties": {
    "schema": {"const": "htdt.capture.accuracy-benchmark-ruleset"},
    "schema_version": {"const": "1.0.0"},
    "ruleset_version": {"type": "string", "minLength": 1},
    "threshold_notice": {
      "const": "provisional_engineering_gate_not_product_claim"
    },
    "minimum_repeat_scans": {"type": "integer", "minimum": 2},
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_max_abs_error_m", "dimension_rmse_m",
        "repeatability_population_sd_m", "plane_residual_rmse_m",
        "roomplan_mesh_alignment_rmse_m", "loop_closure_error_m",
        "annotation_position_repeatability_rmse_m",
        "speaker_orientation_max_error_deg"
      ],
      "properties": {
        "dimension_max_abs_error_m": {"type": "number", "minimum": 0},
        "dimension_rmse_m": {"type": "number", "minimum": 0},
        "repeatability_population_sd_m": {"type": "number", "minimum": 0},
        "plane_residual_rmse_m": {"type": "number", "minimum": 0},
        "roomplan_mesh_alignment_rmse_m": {"type": "number", "minimum": 0},
        "loop_closure_error_m": {"type": "number", "minimum": 0},
        "annotation_position_repeatability_rmse_m": {"type": "number", "minimum": 0},
        "speaker_orientation_max_error_deg": {"type": "number", "minimum": 0}
      }
    },
    "depth_buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min_m", "max_m", "max_rmse_m", "minimum_samples"],
        "properties": {
          "min_m": {"type": "number", "minimum": 0},
          "max_m": {"type": "number", "exclusiveMinimum": 0},
          "max_rmse_m": {"type": "number", "minimum": 0},
          "minimum_samples": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
