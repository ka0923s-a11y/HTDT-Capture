{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htdt.example/schemas/evaluation-record-v1.schema.json",
  "title": "HTDT-Capture Evaluation Record v1",
  "description": "Common result/provenance envelope for iOS 27 capability-program evaluation lanes (legacy bolph71656-ai/HTDT-Capture#274). One record = one lane run (or lane run segment) against one fixture/protocol. Numerical facts carry numeric metrics; generated behavior carries trial counts/rates. Aggregate accuracy never excuses an authority_violation failure category.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "lane", "campaign", "environment",
    "fixture", "metrics", "result", "decision"
  ],
  "properties": {
    "schema": {"const": "htdt.evaluation.record"},
    "schema_version": {"const": "1.0.0"},
    "lane": {
      "type": "string",
      "description": "Lane identifier: 'baseline-0' or 'lane-a'..'lane-g' (see evaluation/lanes/).",
      "pattern": "^(baseline-0|lane-[a-g])$"
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["campaign_id", "protocol_revision"],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1},
        "protocol_revision": {
          "type": "string",
          "description": "Revision/digest of the lane protocol document used."
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "app_commit", "ios_version", "xcode_version", "sdk_version",
        "device_model_identifier"
      ],
      "properties": {
        "app_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$",
          "description": "Git commit of the build under test."
        },
        "ios_version": {"type": "string", "description": "e.g. '27.0'."},
        "ios_build": {"type": "string"},
        "xcode_version": {"type": "string"},
        "sdk_version": {"type": "string"},
        "device_model_identifier": {
          "type": "string",
          "description": "e.g. 'iPhone18,2' — hardware family, not a marketing name."
        },
        "device_family": {"type": "string"}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ar_configuration": {"type": "string"},
        "video_format": {"type": "string"},
        "hdr": {"type": "boolean"},
        "visual_profile": {"type": "string"},
        "feature_under_test": {"type": "string"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "private_fixture"],
      "properties": {
        "case_id": {
          "type": "string",
          "description": "Fixture/case identifier without private-room content."
        },
        "fixture_revision": {"type": "string"},
        "private_fixture": {
          "type": "boolean",
          "description": "true when the underlying imagery stays local; only the manifest/count/aggregate is committed."
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind"],
        "properties": {
          "name": {"type": "string"},
          "kind": {
            "enum": ["numeric", "rate", "count", "boolean"]
          },
          "value": {
            "type": "number",
            "description": "Aggregate value for numeric/rate metrics."
          },
          "unit": {"type": "string"},
          "tolerance": {"type": "number"},
          "trials": {
            "type": "integer",
            "minimum": 1,
            "description": "Trial count when behavior is probabilistic."
          },
          "successes": {"type": "integer", "minimum": 0},
          "distribution": {
            "type": "object",
            "additionalProperties": true,
            "description": "e.g. {p50: 12.1, p95: 31.4} — report distributions, not best samples."
          }
        }
      }
    },
    "model_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "revision"],
        "properties": {
          "component": {
            "type": "string",
            "description": "e.g. 'SystemLanguageModel.variant', 'prompt-template', 'equipment-catalog', 'reference-object'."
          },
          "revision": {"type": "string"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregate"],
      "properties": {
        "aggregate": {
          "enum": ["pass", "fail", "insufficient_data", "mixed"]
        },
        "failure_categories": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "e.g. 'authority_violation', 'ocr_exact_mismatch', 'depth_missing', 'context_overflow'. 'authority_violation' is always a hard failure."
          }
        },
        "baseline_comparison": {
          "type": "string",
          "description": "How this compares to the simplest existing baseline (deterministic/manual/native)."
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "enum": [
            "adopt", "experimental", "change", "roll_back", "not_planned"
          ]
        },
        "rationale": {"type": "string"},
        "blind_spots": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Known coverage gaps this run does not clear."
        }
      }
    }
  }
}
