{
  "schema": "htdt.capture.foundation-document-vectors",
  "schema_version": "1.0.0",
  "description": "Shared positive/negative vectors for the Phase 1 foundation schemas. Positive documents mirror what the production Swift authority models emit (sorted-keys compact JSON). Each negative vector names the schema, a human-readable mutation, and the mutated document that must be rejected.",
  "positive": [
    {
      "name": "session",
      "schema_file": "session.schema.json",
      "document": {
        "schema": "htdt.capture.session",
        "schema_version": "1.0.0",
        "capture_session_id": "00000000-0000-4000-8000-000000000003",
        "coordinate_space_id": "00000000-0000-4000-8000-000000000004",
        "capture_mode": "roomplan_mesh",
        "started_at": "2026-09-20T00:00:00Z",
        "configuration_ref": "session/capture-configuration.json",
        "timing_ref": "session/timing.json"
      }
    },
    {
      "name": "device",
      "schema_file": "device.schema.json",
      "document": {
        "schema": "htdt.capture.device",
        "schema_version": "1.0.0",
        "platform": "iOS",
        "os_version": "26.0",
        "os_build": "23A100",
        "hardware_model": "iPhone17,1",
        "app_version": "1.0.0",
        "app_build": "42"
      }
    },
    {
      "name": "capabilities",
      "schema_file": "capabilities.schema.json",
      "document": {
        "schema": "htdt.capture.capabilities",
        "schema_version": "1.0.0",
        "roomplan_supported": true,
        "world_tracking_supported": true,
        "scene_reconstruction_supported": true,
        "scene_depth_supported": true,
        "smoothed_scene_depth_supported": false,
        "high_resolution_frame_supported": true,
        "combined_mode_probe": {
          "roomplan_mesh_ok": true,
          "roomplan_scene_depth_ok": false,
          "same_session_depth_after_roomplan_stop_ok": true
        }
      }
    },
    {
      "name": "capture-configuration",
      "schema_file": "capture-configuration.schema.json",
      "document": {
        "schema": "htdt.capture.configuration",
        "schema_version": "1.0.0",
        "capture_mode": "roomplan_mesh",
        "world_alignment": "gravity",
        "plane_detection": ["horizontal", "vertical"],
        "scene_reconstruction": "mesh_with_classification",
        "frame_semantics": ["scene_depth", "smoothed_scene_depth"],
        "video_format": {
          "width": 1920,
          "height": 1440,
          "frames_per_second": 60,
          "pixel_format": "420f"
        },
        "autofocus_enabled": true,
        "roomplan": {"detail_level": "full"}
      }
    },
    {
      "name": "timing",
      "schema_file": "timing.schema.json",
      "document": {
        "schema": "htdt.capture.timing",
        "schema_version": "1.0.0",
        "clock_domain": "arkit_arframe_timestamp_seconds",
        "correlations": [
          {
            "monotonic_s": 0.0,
            "utc": "2026-09-20T00:00:00Z",
            "method": "device_uptime_epoch",
            "estimated_uncertainty_s": 0.001
          },
          {
            "monotonic_s": 60.0,
            "utc": "2026-09-20T00:01:00Z",
            "method": "device_uptime_epoch",
            "estimated_uncertainty_s": null
          }
        ]
      }
    }
  ],
  "negative": [
