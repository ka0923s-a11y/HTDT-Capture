{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htdt.example/schemas/capture-bundle-v1/session.schema.json",
  "title": "HTDT Capture Session v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "capture_session_id",
    "coordinate_space_id"
  ],
  "properties": {
    "schema": {
      "const": "htdt.capture.session"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "capture_session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "coordinate_space_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "capture_mode": {
      "enum": [
        "roomplan_mesh",
        "evidence_depth",
        "degraded_no_depth"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "configuration_ref": {
      "type": "string",
      "minLength": 1
    },
    "timing_ref": {
      "type": "string",
      "minLength": 1
    }
  }
}
