{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://htdt.example/schemas/capture-bundle-v1/entities.schema.json",
  "title": "HTDT Capture Entities v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "entities"
  ],
  "properties": {
    "schema": {
      "const": "htdt.capture.entities"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "vector3f": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "matrix4f": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "values"
      ],
      "properties": {
        "representation": {
          "const": "column_major_4x4_f32"
        },
        "values": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "front_axis_local",
        "up_axis_local"
      ],
      "properties": {
        "front_axis_local": {
          "$ref": "#/$defs/vector3f"
        },
        "up_axis_local": {
          "$ref": "#/$defs/vector3f"
        }
      }
    },
    "acousticCenter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset_local_m",
        "authority_ref"
      ],
      "properties": {
        "offset_local_m": {
          "$ref": "#/$defs/vector3f"
        },
        "authority_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "source_evidence_refs"
      ],
      "properties": {
        "method": {
          "enum": [
            "manual_numeric",
            "raycast",
            "mesh_hit_test",
            "roomplan_binding",
            "imported_reference",
            "other"
          ]
        },
        "source_semantic_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_mesh_anchor_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "source_roomplan_object_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "type",
        "coordinate_space_id",
        "T_world_from_annotation",
        "reference_point_semantics",
        "label",
        "provenance_class",
        "verification_state",
        "placement",
        "evidence_refs"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "type": {
          "enum": [
            "speaker",
            "subwoofer",
            "display",
            "projection_screen",
            "listening_position",
            "seat",
            "acoustic_treatment",
            "equipment_rack",
            "reference_point",
            "custom"
          ]
        },
        "coordinate_space_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "T_world_from_annotation": {
          "$ref": "#/$defs/matrix4f"
        },
        "reference_point_semantics": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "provenance_class": {
          "enum": [
            "user_annotation",
            "imported_reference",
            "capture_app_derived"
          ]
        },
        "verification_state": {
          "enum": [
            "unverified",
            "user_attested",
            "evidence_linked"
          ]
        },
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "orientation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/orientation"
            }
          ]
        },
        "channel_role": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z0-9_]+$"
        },
        "acoustic_center": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/acousticCenter"
            }
          ]
        },
        "equipment_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "speaker"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "orientation",
              "channel_role"
            ],
            "properties": {
              "orientation": {
                "$ref": "#/$defs/orientation"
              },
              "channel_role": {
                "type": "string",
                "pattern": "^[A-Z0-9_]+$"
              }
            }
          }
        }
      ]
    }
  }
}
